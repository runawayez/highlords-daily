# Highlords Daily Vanilla — Brazil-first defaults
PRESET=br
EDITORIAL_PROFILE=balanced

OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:4b
LANGUAGE=pt-BR
EDITORIAL_CONTEXT=Brasil
TIME_ZONE=America/Sao_Paulo

OUTPUT_DIR=./output
DATA_DIR=./data
MEMORY_FILE=./data/highlords.sqlite
PLUGINS_DIR=./plugins

# Optional overrides. When omitted, PRESET selects presets/<name>/categories.yml and feeds.yml.
# CATEGORIES_FILE=./config/categories.yml
# FEEDS_FILE=./config/feeds.yml
EDITORIAL_PROFILES_FILE=./config/editorial-profiles.yml

PUBLICATION_NAME=Highlords Daily
# PUBLICATION_TAGLINE=Informação sem ruído
PUBLICATION_LOGO=./public/assets/highlords-logo.svg
ACCENT_COLOR=#c92f2b
PAPER_COLOR=#f7f3e9
BACKGROUND_COLOR=#0b0b0d

LOOKBACK_HOURS=48
MAX_ITEMS_PER_FEED=20
MAX_CANDIDATES=160
AI_BATCH_SIZE=10
ITEMS_PER_CATEGORY=2
LLM_MIN_SCORE=4.0

# Bundled human editorial ranking. It deep-scans a larger pool, detects
# cross-source consensus and asks Ollama for a second, human-like importance pass.
EDITORIAL_DEEP_SCAN=true
EDITORIAL_DEEP_ITEMS_PER_FEED=20
EDITORIAL_DEEP_MAX_CANDIDATES=160
EDITORIAL_DEEP_LLM_MIN_SCORE=4.0
EDITORIAL_CYCLE_OVERLAP_HOURS=3
EDITORIAL_RANKING_BATCH_SIZE=14
EDITORIAL_GLOBAL_CALIBRATION_SIZE=30

MAX_ITEMS_PER_SOURCE=3
MAX_ITEMS_PER_SOURCE_PER_SECTION=1
SOURCE_DIVERSITY_STRICT=false

REQUIRE_IMAGES=true
CACHE_IMAGES=true
HISTORY_ENABLED=true
HISTORY_DAYS=90
DUPLICATE_DAYS=7
DUPLICATE_THRESHOLD=0.72

EXPORT_MARKDOWN=true
EXPORT_EMAIL=true
EXPORT_SOCIAL=true
ARCHIVE_ENABLED=true
PLUGINS_ENABLED=true
AUTO_OPEN=true
