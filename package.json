{
  "name": "highlords-daily",
  "version": "4.0.0",
  "private": true,
  "type": "module",
  "description": "Local-first universal daily newsletter engine powered by RSS/Atom and Ollama, with configurable locale, editorial profiles, memory and multi-format exports.",
  "keywords": [
    "newsletter",
    "ollama",
    "local-ai",
    "local-first",
    "llm",
    "rss",
    "atom",
    "pdf",
    "news-curation",
    "news-aggregator"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/runawayez/highlords-daily.git"
  },
  "homepage": "https://github.com/runawayez/highlords-daily#readme",
  "bugs": {
    "url": "https://github.com/runawayez/highlords-daily/issues"
  },
  "scripts": {
    "daily": "node src/daily.mjs",
    "setup": "node src/cli/setup.mjs",
    "feeds:check": "node src/cli/feeds-check.mjs",
    "feeds:discover": "node src/cli/feeds-discover.mjs",
    "pdf:rerender": "node src/cli/pdf-rerender.mjs",
    "reset:local": "node src/cli/reset-local.mjs",
    "schedule": "node src/cli/schedule.mjs",
    "schedule:remove": "node src/cli/schedule.mjs --remove",
    "desktop": "npm --prefix desktop start",
    "desktop:install": "npm --prefix desktop install",
    "desktop:build": "npm --prefix desktop run dist",
    "check": "node scripts/check.mjs",
    "test": "node --test",
    "doctor": "node src/cli/doctor.mjs"
  },
  "engines": {
    "node": ">=22.5.0"
  },
  "dependencies": {
    "puppeteer-core": "^24.31.0",
    "rss-parser": "^3.13.0",
    "yaml": "^2.6.1"
  }
}
