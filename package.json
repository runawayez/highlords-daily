{
  "name": "highlords-daily",
  "version": "5.5.3",
  "private": true,
  "type": "module",
  "description": "Local-first universal daily newsletter engine powered by RSS/Atom and Ollama, with configurable locale, editorial profiles, memory and multi-format exports.",
  "keywords": [
    "newsletter",
    "ollama",
    "local-ai",
    "local-first",
    "llm",
    "rss",
    "atom",
    "pdf",
    "news-curation",
    "news-aggregator"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/runawayez/highlords-daily.git"
  },
  "homepage": "https://github.com/runawayez/highlords-daily#readme",
  "bugs": {
    "url": "https://github.com/runawayez/highlords-daily/issues"
  },
  "scripts": {
    "daily": "node src/cli/run.mjs daily",
    "setup": "node src/cli/setup.mjs",
    "feeds:check": "node src/cli/feeds-check.mjs",
    "feeds:discover": "node src/cli/feeds-discover.mjs",
    "pdf:rerender": "node src/cli/run.mjs pdf",
    "reset:local": "node src/cli/reset-local.mjs",
    "schedule": "node src/cli/run.mjs schedule",
    "schedule:remove": "node src/cli/run.mjs schedule --remove",
    "desktop": "npm --prefix desktop start",
    "desktop:install": "npm --prefix desktop ci",
    "desktop:build": "npm --prefix desktop run dist",
    "check": "node scripts/check.mjs",
    "test": "node --test",
    "doctor": "node src/cli/run.mjs doctor",
    "sources:discover": "node src/cli/run.mjs sources",
    "locale:generate": "node src/cli/run.mjs locale",
    "deliver": "node src/cli/run.mjs deliver",
    "config:show": "node src/cli/run.mjs config",
    "cache:prune": "node src/cli/run.mjs cache",
    "benchmark": "node src/cli/run.mjs benchmark",
    "format": "prettier --write \"src/**/*.mjs\" \"plugins/**/*.mjs\" \"presets/**/*.mjs\" \"scripts/**/*.mjs\" \"tests/**/*.mjs\" \"desktop/*.mjs\"",
    "format:check": "prettier --check \"src/**/*.mjs\" \"plugins/**/*.mjs\" \"presets/**/*.mjs\" \"scripts/**/*.mjs\" \"tests/**/*.mjs\" \"desktop/*.mjs\"",
    "editorial:evaluate": "node src/cli/run.mjs evaluate",
    "feedback:import": "node src/cli/run.mjs feedback",
    "test:visual": "node scripts/visual-regression.mjs",
    "layout:preview": "node src/cli/run.mjs preview",
    "start": "node src/cli/launch.mjs"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "entities": "^2.2.0",
    "puppeteer-core": "^25.12.0",
    "rss-parser": "^3.13.0",
    "yaml": "^2.6.1"
  },
  "optionalDependencies": {
    "nodemailer": "^10.0.16"
  },
  "devDependencies": {
    "prettier": "^3.9.9"
  }
}
